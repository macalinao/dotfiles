#!/usr/bin/env bash

if [ "${IGM_SWITCH_DISABLE:-}" = "true" ]; then
	echo "igm-switch: disabled on this machine (IGM_SWITCH_DISABLE=true)." >&2
	exit 1
fi

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
cd $DOTFILES

SHOW_TRACE=''
if [ "${1:none}" = '--debug' ]; then
	SHOW_TRACE='--show-trace'
fi

if $(uname -a | grep -q "Darwin"); then
	# Mac hosts are no longer defined here — they live in the private
	# darwin-configuration flake, which consumes this repo (via
	# lib.mkDarwinHost) plus dotfiles-private. Delegate to its switch script,
	# which handles the local --override-input wiring for both.
	DARWIN_CONFIG="${DARWIN_CONFIG:-$HOME/proj/macalinao/darwin-configuration}"
	if [ ! -x "$DARWIN_CONFIG/scripts/darwin-switch" ]; then
		echo "igm-switch: no darwin-switch at $DARWIN_CONFIG." >&2
		echo "Clone github:macalinao/darwin-configuration there, or set DARWIN_CONFIG." >&2
		exit 1
	fi
	exec "$DARWIN_CONFIG/scripts/darwin-switch" $SHOW_TRACE
fi

# NixOS hosts are built from github:macalinao/configuration, which consumes
# this repo as a flake input; use its scripts/devbox-switch there.
echo "igm-switch: only macOS is supported; NixOS hosts are managed by" >&2
echo "github:macalinao/configuration (scripts/devbox-switch)." >&2
exit 1
